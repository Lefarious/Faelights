{
  "name": "faelights",
  "productName": "Faelights",
  "version": "1.3.1",
  "description": "Pull highlights out of annotated PDFs, organised by topic, and keep them in libraries.",
  "main": "src/main.js",
  "bin": {
    "faelights": "cli/faelights.js",
    "faelights-mcp": "mcp/server.js"
  },
  "author": "Joel Nanayakkara",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "cli": "node cli/faelights.js",
    "mcp": "node mcp/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.0.0",
    "@fontsource/newsreader": "^5.0.0",
    "@fontsource/young-serif": "^5.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "3.11.174",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "app.faelights.desktop",
    "productName": "Faelights",
    "npmRebuild": false,
    "files": [
      "src/**",
      "core/**",
      "renderer/**",
      "node_modules/pdfjs-dist/build/pdf.min.js",
      "node_modules/pdfjs-dist/build/pdf.worker.min.js",
      "node_modules/pdf-lib/dist/pdf-lib.min.js",
      "node_modules/@fontsource/**",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "afterPack": "scripts/set-exe-icon.js"
  }
}
